# Copy to .env for local development. Never commit .env.

# Required for speech-to-text and AI translation.
OPENAI_API_KEY=

# development | production  (production enforces codes, keys and locks paid endpoints)
MINBAR_ENV=development

# Secret broadcast code per mosque: ROOM_ID=CODE, comma separated.
# Room ids come from data/mosques.json. Choose your own strong code.
MINBAR_BROADCAST_CODES=KHATAM-2026=change-me

# Only needed when another origin must call the API (same-origin needs nothing).
MINBAR_ALLOWED_ORIGINS=

# Optional tuning
MINBAR_MAX_UPLOAD_BYTES=26214400
MINBAR_ROOM_TTL_SECONDS=7200
MINBAR_CHUNK_SECONDS=6
MINBAR_LIVE_FLUSH_CHUNKS=2
MINBAR_STT_MODEL=whisper-1
MINBAR_TRANSLATION_MODEL=gpt-5-mini
MINBAR_TRANSLATION_REASONING_EFFORT=minimal
MINBAR_OPENAI_TIMEOUT_SECONDS=60
MINBAR_LOG_LEVEL=INFO
